    {
      "server": {
        "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
        "name": "io.example/weather",
        "description": "Hosted weather forecasts.",
        "version": "2.0.0",
        "remotes": [
          {
            "type": "streamable-http",
            "url": "https://{region}.weather.example/mcp",
            "variables": {
              "region": {
                "description": "Deployment region",
                "isRequired": true,
                "default": "us",
                "choices": [
                  "us",
                  "eu"
                ]
              }
            },
            "headers": [
              {
                "name": "Authorization",
                "description": "API token",
                "value": "Bearer {api_key}",
                "isRequired": true,
                "isSecret": true,
                "variables": {
                  "api_key": {
                    "description": "Your weather API key",
                    "isRequired": true,
                    "isSecret": true
                  }
                }
              }
            ]
          }
        ]
      },
      "_meta": {
        "io.modelcontextprotocol.registry/official": {
          "status": "active",
          "isLatest": true
        }
      }
    },
